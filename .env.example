# ─────────────────────────────────────────────────────────────
# ProwJack — exemplo de configuração (NUNCA commit secrets reais)
# Copie para `.env` e preencha. Nunca coloque este arquivo no git.
# ─────────────────────────────────────────────────────────────

# ── Prowlarr/Jackett (obrigatório) ─────────────────────────────
# Em Vercel / Hugging Face / VPS, deve ser uma URL HTTP(S) acessível
# publicamente. O HF bloqueia saída para portas 9117/9696/6379/5432.
# Use o IP do host se o Prowlarr estiver na mesma rede Docker.
JACKETT_URL=
JACKETT_API_KEY=

# ── TMDB (opcional) — título/sinopse em pt-BR e metadados ──────
# Pode usar uma API key v3 ou um Bearer token v4.
TMDB_API_KEY=
TMDB_BEARER_TOKEN=

# ── Token de acesso (RECOMENDADO em instância pública) ─────────
# Impede uso não autorizado do addon (protege /api/config, /api/indexers,
# /api/debrid, /api/metrics e a criação de configs arbitrárias — vetor SSRF).
# Deve ser preenchido também no campo "Token de Acesso" na UI de configuração.
ACCESS_TOKEN=

# ── Redis (cache) ──────────────────────────────────────────────
# URL com ou sem credenciais. Use PROJACK_REDIS_DISABLED=1 em ambientes
# sem Redis (ex.: serverless) para forçar cache em memória pura.
REDIS_URL=
PROJACK_REDIS_DISABLED=0

# ── Persistência das configurações cfg_... ─────────────────────
# Em VPS/Docker, deixe vazio para usar CONFIG_DATA_DIR/prowjack_configs.json.
# Em Vercel/serverless, configure uma URL Postgres do Marketplace.
# Aceita CONFIG_DATABASE_URL, POSTGRES_URL ou DATABASE_URL.
CONFIG_DATABASE_URL=
CONFIG_DATABASE_TABLE=prowjack_configs
CONFIG_DATA_DIR=/data
# Apenas se realmente precisar validar o certificado no Postgres remoto.
# DB_SSL_REJECT_UNAUTHORIZED=true

# ── URL pública do addon ───────────────────────────────────────
# Necessária atrás de proxy/hosting (HF Spaces, Vercel, Cloudflare Tunnel).
# Ex.: https://seu-space.hf.space  ou  https://prowjack.example.com
ADDON_PUBLIC_URL=

# ── Porta do servidor ──────────────────────────────────────────
# O Docker Space do HF usa 7860; o ambiente local usa 7014.
PORT=7014

# ── Feature flags (instância pública) ──────────────────────────
# Em produção as funcionalidades experimentais ficam OCULTAS da UI e
# inacessíveis no backend salvo se habilitadas explicitamente.
# qBittorrent HTTP:
#   true  → UI exibe e endpoints funcionam (testes locais)
#   false → UI oculta e backend retorna 404
#   (vazio → herdado da configuração: ligado apenas se QBIT_URL/USER/PASS setados)
ENABLE_QBITTORRENT=false

# Catálogo RSS (Stremio Home):
#   true  → habilitado (ainda exige RSS_CATALOG_INDEXERS preenchido)
#   false → oculto na UI e sem polling/rotas
#   (vazio → herdado de RSS_CATALOG_INDEXERS)
ENABLE_RSS_CATALOG=false

# Debrid via StremThru (modo alternativo):
#   true  → opção exibida na UI e aceita no backend (padrão)
#   false → oculta na UI e descarta stConfig no backend (como ENABLE_QBITTORRENT)
#   (vazio → habilitado)
ENABLE_STREMTHRU=true

# Modo P2P:
#   true  → streams P2P (magnet/infoHash) são entregues quando não há debrid (padrão)
#   false → NÃO entrega P2P; o manifest só é gerado se debrid nativo (ou StremThru)
#           estiver configurado (evita addon sem fonte para entregar)
ENABLE_PURE_P2P=true

# Indexers que terão catálogo gerado (IDs ou nomes, separados por vírgula).
# Vazio = somente indexers privados. Requer ENABLE_RSS_CATALOG=true.
# Exemplo: RSS_CATALOG_INDEXERS=5,11,CapybaraBR
RSS_CATALOG_INDEXERS=

# Intervalo do poller do catálogo RSS (minutos).
RSS_UPDATE_INTERVAL_MINUTES=30

# ── Scrap de addons externos (buscas adicionais) ───────────────
# Manifests de addons Stremio externos (separados por vírgula).
# Streams desses addons têm prioridade sobre trackers privados, mas não sobre debrid.
# Ex.: SCRAP_MANIFEST_URLS=https://torrentio.strem.fun/manifest.json
SCRAP_MANIFEST_URLS=

P2P_MIN_SEEDERS=5

# ── qBittorrent (somente se ENABLE_QBITTORRENT=true) ───────────
QBIT_URL=
QBIT_USER=
QBIT_PASS=
QBIT_SAVE_DIR=/data/prowjack
QBIT_MIN_PROGRESS=0.01
QBIT_BUFFER_TIMEOUT=180
QB_EXTRA_SLOTS=5
# Mapeamento de caminhos p/ Docker: "/downloads:C:\Users\SeuUser\Downloads\torrents"
# QBIT_DOCKER_PATH_MAPPING=
# Categoria/tags usadas no qBit (opcional).
# QBIT_CATEGORY=prowjack-private
# QBIT_TAGS=prowjack
# Logs detalhados do qBit (booleano).
# DEBUG_QBIT=false

# ── StremThru ──────────────────────────────────────────────────
# URL pública do servidor StremThru (usada pela UI como valor padrão).
STREMTHRU_URL=
# Aguarda a primeira busca completa do upstream interno do StremThru.
STREMTHRU_PROXY_TIMEOUT_MS=60000

# ── Logs ────────────────────────────────────────────────────────
# Nível de log: error | warn | info (padrão) | debug | silent
#   info  → informações básicas (buscas, resultados, erros) — RECOMENDADO em produção
#   debug → detalhes de fluxo interno (perf, cache, indexadores) para diagnóstico
LOG_LEVEL=info

# ── Diversos ───────────────────────────────────────────────────
# Origem permitida via CORS (vazio = todas).
# ALLOWED_ORIGINS=
# Concorrência da fila de resolução de infoHash (magnet/.torrent).
# INFOHASH_QUEUE_CONCURRENCY=3